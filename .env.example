# Notion Integration
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Notion template page IDs (leave blank to use built-in templates)
# Copy the page ID from the URL: notion.so/workspace/PAGE_ID?v=...
NOTION_DAILY_TEMPLATE_ID=
NOTION_WEEKLY_TEMPLATE_ID=
NOTION_MONTHLY_TEMPLATE_ID=

# OpenAI (for Whisper transcription)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub backup (private repo for journal entries)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_JOURNAL_REPO=journal-entries

# Scheduler timezone (e.g. Asia/Kolkata, America/New_York, Europe/London)
SCHEDULER_TIMEZONE=Asia/Kolkata

# Weekly entry: day of week (mon, tue, wed, thu, fri, sat, sun)
WEEKLY_ENTRY_DAY=sun
# Weekly entry creation time (HH:MM 24h)
WEEKLY_ENTRY_TIME=20:00

# Monthly entry creation time (HH:MM 24h, runs on 1st of each month)
MONTHLY_ENTRY_TIME=09:00
